#include<iostream>
int main()
{
  // HERE USING ARTHIMATIC OPEARTORS (+ , - , * , / , % )
  int  x,y;
  std::cout<<" enter your number for x and y"<<std::endl;
  std::cin>>x;
  std::cin>>y;

  std::cout<< " x + y is = "<< x+y <<std::endl;
  std::cout<<" x - y is = "<<x-y << std::endl;
  std::cout<< "x * y is = "<<x*y<< std::endl;
  std::cout<< "x / y is = "<<x/y<< std::endl;
  std::cout<< "x % y is = "<<x%y<< std::endl;

  return 0;
}   